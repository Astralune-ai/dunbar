# Point this at your dunbar workspace.
# The contacts-sync and contacts-add skills look for $DUNBAR_ROOT first.
DUNBAR_ROOT="$HOME/path/to/your/dunbar"

# ─── v1.1+ optional integrations (not used yet) ───

# LinkedIn scraping API (bring your own key — we never ship one)
# LINKEDIN_API_KEY=

# 小红书 / Xiaohongshu scraping API (BYOK)
# XHS_API_KEY=

# ─── v2.0 Google Workspace integration (planned) ───

# Most users will rely on the `gws` CLI's existing auth — no env vars needed.
# Alternatively, point at your own OAuth client credentials:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
